[Unit]
Description=Сайт школьного расписания
After=network.target

[Service]
User=schedule
Group=schedule
WorkingDirectory=/opt/school-schedule
# Слушаем только локальный адрес: снаружи сайт доступен через Caddy по HTTPS.
ExecStart=/opt/school-schedule/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/school-schedule/data

[Install]
WantedBy=multi-user.target
