# Скопируйте этот файл в .env и при необходимости поменяйте значения.

# Часовой пояс школы: от него зависит, какой день считается «сегодня».
SCHOOL_TZ=Europe/Moscow

# Где хранить базу данных (по умолчанию data/schedule.db рядом с кодом).
# DB_PATH=/var/lib/school-schedule/schedule.db

# Флаг Secure у cookie входа: auto — по HTTPS, 1 — всегда, 0 — никогда (только для локальной проверки).
COOKIE_SECURE=auto

# Сколько часов действует вход в панель.
SESSION_HOURS=12
